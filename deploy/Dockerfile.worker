FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/QualGuardIQ.Worker -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
# ffmpeg/ffprobe for video playback copies (Video:FfmpegPath); headless office (no GUI) for legacy .doc/.xls imports run in the background.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libreoffice-writer-nogui libreoffice-calc-nogui fonts-dejavu-core fonts-liberation2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
USER app
ENTRYPOINT ["dotnet", "QualGuardIQ.Worker.dll"]
