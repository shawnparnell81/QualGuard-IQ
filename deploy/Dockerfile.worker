FROM mcr.microsoft.com/dotnet/sdk:10.0.402@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/QualGuardIQ.Worker -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0.13@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac
# ffmpeg/ffprobe for video playback copies (Video:FfmpegPath); headless office (no GUI) for legacy .doc/.xls imports run in the background;
# poppler-utils (pdftoppm) renders scanned PDF pages for OCR.
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libreoffice-writer-nogui libreoffice-calc-nogui fonts-dejavu-core fonts-liberation2 poppler-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
# Data Protection keys (sign-in cookies, encrypted settings) live on the dpkeys volume so they survive rebuilds
RUN mkdir -p /keys && chown app:app /keys
USER app
ENTRYPOINT ["dotnet", "QualGuardIQ.Worker.dll"]
