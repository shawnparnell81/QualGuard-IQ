FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/QualGuardIQ.Api -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
# wget for the compose health check; ffmpeg/ffprobe so the API reports video conversion status for this host;
# headless office (no GUI) for legacy .doc/.xls intake and the original-document previews in the Import Center;
# poppler-utils (pdftoppm) renders scanned PDF pages for OCR. OCR itself is optional: install and configure a provider (Ocr:Provider).
RUN apt-get update && apt-get install -y --no-install-recommends wget ffmpeg libreoffice-writer-nogui libreoffice-calc-nogui fonts-dejavu-core fonts-liberation2 poppler-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out .
# Data Protection keys (sign-in cookies, encrypted settings) live on the dpkeys volume so they survive rebuilds
RUN mkdir -p /keys && chown app:app /keys
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "QualGuardIQ.Api.dll"]
