# QualGuard IQ settings for docker compose. Copy this file to .env and fill in the values.
# Use letters, numbers and - _ . ! @ in passwords (no $, ; or quotes, no spaces).

# --- Database (PostgreSQL in a container; not published on the host, so it never clashes with a local PostgreSQL) ---
# Owner login: only the one-time "migrate" step uses it, to update the database.
POSTGRES_PASSWORD=
# Day-to-day login for the API and worker (created for you as qgiq_app). At least 12 characters and different from
# POSTGRES_PASSWORD. It can read and write data but can't change tables or edit the audit trail.
POSTGRES_APP_PASSWORD=
# Only used with docker-compose.db-port.yml (optional desktop database access). 5433 avoids a local server on 5432.
POSTGRES_HOST_PORT=5433

# --- Web app ---
# Port on this computer for the web app: http://localhost:8081
WEB_PORT=8081
# Address people use to open the app (used in password reset links). Keep it in step with WEB_PORT.
APP_BASE_URL=http://localhost:8081
APP_NAME=QualGuard IQ
ORGANIZATION_NAME=Your Organization
TIME_ZONE=America/New_York

# --- First administrator (created once, on the first start, when the database has no users) ---
# The password must be at least 12 characters and not a common password. You choose a new one at the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# New installations: administrators must set up an authenticator app (two-step verification) at their first sign-in.
# Change later in Admin > Roles. Set false only if you will turn it on yourself.
ADMIN_REQUIRES_MFA=true

# --- Outgoing email (optional; needed for password reset links on a server) ---
# Your mail provider's SMTP server. Leave SMTP_HOST empty to send no email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
# Address the emails come from, for example qms@yourcompany.com
EMAIL_FROM=

# --- File storage ---
# Option 1 (default): MinIO in a container. Keep COMPOSE_PROFILES=minio, set the two MinIO values,
# and leave the STORAGE_* values below empty.
COMPOSE_PROFILES=minio
MINIO_ROOT_USER=qgiqminio
# at least 8 characters
MINIO_ROOT_PASSWORD=
# The app gets its own MinIO login that can only use the file bucket (created for you on start).
# At least 8 characters and different from MINIO_ROOT_PASSWORD.
MINIO_APP_USER=qgiq-app
MINIO_APP_PASSWORD=

# Option 2: Cloudflare R2 (or another S3-compatible service). Set COMPOSE_PROFILES= (empty) so MinIO is not started, then:
#   STORAGE_SERVICE_URL  the R2 "S3 API" address without the bucket name, e.g. https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_BUCKET       qms-files (the bucket must already exist in R2)
#   STORAGE_REGION       auto
#   STORAGE_ACCESS_KEY   the R2 API token's Access Key ID
#   STORAGE_SECRET_KEY   the R2 API token's Secret Access Key
#   STORAGE_FORCE_PATH_STYLE  true
STORAGE_SERVICE_URL=
STORAGE_BUCKET=qms-files
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# --- Virus scanning (optional) ---
# Off by default: uploads are stored and marked "Not scanned", and administrators see a notice in Admin.
# To turn it on (Intel/AMD and ARM computers; needs about 3 GB of extra memory): set MALWARE_SCANNER=ClamAV and add clamav
# to COMPOSE_PROFILES, for example COMPOSE_PROFILES=minio,clamav. The first start downloads virus definitions (a few minutes).
MALWARE_SCANNER=

# --- HTTPS (optional, for a server people reach by name; not needed on a laptop) ---
# Add https to COMPOSE_PROFILES (for example COMPOSE_PROFILES=minio,https), set QG_DOMAIN to the name people type, and set
# APP_BASE_URL=https://<that name>. Caddy gets a free Let's Encrypt certificate when the name points at this computer and
# ports 80 and 443 are reachable. Inside a company network only, set QG_TLS=tls internal (Caddy's own certificate).
# http://localhost:8081 keeps working on the computer itself.
QG_DOMAIN=
QG_TLS=

# --- Proxies allowed to report the real client address (advanced) ---
# Defaults to the private ranges docker compose uses. Only change this if you put another proxy in front of the API.
TRUSTED_PROXY_NETWORKS=

# --- Backups (docker compose run --rm backup) ---
# Folder for the database and key ring backups. Leave empty for the backups folder next to docker-compose.yml.
BACKUP_DIR=

# --- Production server only (docker-compose.prod.yml) ---
# Daily backup time (HH:MM, in TIME_ZONE) and how many days of backups to keep (0 keeps all).
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=14
# Size limit for each container's log file and how many old log files to keep.
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
