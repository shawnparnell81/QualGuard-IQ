# QualGuard IQ settings for docker compose. Copy this file to .env and fill in the values.
# Use letters, numbers and - _ . ! @ in passwords (no $, ; or quotes, no spaces).

# --- Database (PostgreSQL in a container; not published on the host, so it never clashes with a local PostgreSQL) ---
POSTGRES_PASSWORD=
# Only used with docker-compose.db-port.yml (optional desktop database access). 5433 avoids a local server on 5432.
POSTGRES_HOST_PORT=5433

# --- Web app ---
# Port on this computer for the web app: http://localhost:8081
WEB_PORT=8081
# Address people use to open the app (used in password reset links). Keep it in step with WEB_PORT.
APP_BASE_URL=http://localhost:8081
APP_NAME=QualGuard IQ
ORGANIZATION_NAME=Your Organization
TIME_ZONE=America/New_York

# --- First administrator (created once, on the first start, when the database has no users) ---
# The password must be at least 12 characters and not a common password. You choose a new one at the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- File storage ---
# Option 1 (default): MinIO in a container. Keep COMPOSE_PROFILES=minio, set the two MinIO values,
# and leave the STORAGE_* values below empty.
COMPOSE_PROFILES=minio
MINIO_ROOT_USER=qgiqminio
# at least 8 characters
MINIO_ROOT_PASSWORD=

# Option 2: Cloudflare R2 (or another S3-compatible service). Set COMPOSE_PROFILES= (empty) so MinIO is not started, then:
#   STORAGE_SERVICE_URL  the R2 "S3 API" address without the bucket name, e.g. https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_BUCKET       qms-files (the bucket must already exist in R2)
#   STORAGE_REGION       auto
#   STORAGE_ACCESS_KEY   the R2 API token's Access Key ID
#   STORAGE_SECRET_KEY   the R2 API token's Secret Access Key
#   STORAGE_FORCE_PATH_STYLE  true
STORAGE_SERVICE_URL=
STORAGE_BUCKET=qms-files
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true
